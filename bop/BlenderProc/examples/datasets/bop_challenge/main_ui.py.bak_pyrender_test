            "rotation": np.asarray(
                obj.get_rotation_euler()
            ).copy(),
        }
        for obj in target_bop_objs
    ]

    if distractor_library:
        count = min(
            DISTRACTOR_OBJECT_COUNT,
            len(distractor_library),
        )

        selected_distractors = list(
            np.random.choice(
                distractor_library,
                size=count,
                replace=False,
            )
        )
    else:
        selected_distractors = []

    print(
        "[DISTRACTOR] selected: "
        + (
            ", ".join(
                obj.get_name()
                for obj in selected_distractors
            )
            if selected_distractors
            else "NONE"
        )
    )

    for obj in selected_distractors:
        obj.hide(False)
        obj.disable_rigidbody()

    if is_scene_b:
        for obj, transform in zip(
            target_bop_objs,
            target_initial_transforms,
        ):
            obj.disable_rigidbody()

            restore_initial_pose(
                obj,
                transform,
                scene_rotation,
                box_reference_center,
            )

        print(
            "[SCENE] Target collision: DISABLED"
        )

    else:
        if ENABLE_PHYSICS:
            for obj in target_bop_objs:
                setup_dynamic_collision(obj)

        bproc.object.sample_poses(
            objects_to_sample=target_bop_objs,
            sample_pose_func=lambda obj:
                sample_false_pose(
                    obj,
                    scene_rotation,
                ),
            max_tries=1000,
        )

        print(
            "[SCENE] Target collision: ENABLED"
        )

    valid_distractors = []

    for obj in selected_distractors:
        if sample_distractor_pose(obj):
            valid_distractors.append(obj)
        else:
            print(
                f"[DISTRACTOR] Could not place "
                f"{obj.get_name()} outside Box; "
                f"hiding."
            )

            obj.hide(True)

    selected_distractors = (
        valid_distractors
    )

    if ENABLE_PHYSICS:
        for obj in selected_distractors:
            setup_dynamic_collision(obj)

    if ENABLE_PHYSICS and not is_scene_b:
        bproc.object.simulate_physics_and_fix_final_poses(
            min_simulation_time=3,
            max_simulation_time=10,
            check_object_interval=1,
            substeps_per_frame=PHYSICS_SUBSTEPS,
            solver_iters=PHYSICS_SOLVER_ITERS,
        )

    scene_objects = (
        target_bop_objs
        + selected_distractors
        + [box, table]
    )

    bvh = (
        bproc.object.create_bvh_tree_multi_objects(
            scene_objects
        )
    )

    cam_poses = add_camera_poses(bvh)

    print(
        f"[SCENE {i}] Rendering "
        f"{cam_poses} camera poses "
        f"(requested {args.sample_size}, "
        f"360° horizontal coverage)"
    )

    if cam_poses == 0:
        raise RuntimeError(
            f"[SCENE {i}] "
            f"No valid camera poses found."
        )

    data = bproc.renderer.render()

    print(
        f"[SCENE {i}] Render keys: "
        f"{list(data.keys())}"
    )

    if "colors" not in data:
        raise RuntimeError(
            "[RENDER] RGB colors were not generated."
        )

    if "depth" not in data:
        raise RuntimeError(
            "[RENDER] Depth was not generated."
        )

    print(
        f"[RENDER] RGB frames: "
        f"{len(data['colors'])}"
    )

    print(
        f"[RENDER] Depth frames: "
        f"{len(data['depth'])}"
    )

    print(
        "[SCENE] BOP objects:"
    )

    for obj in target_bop_objs + [box]:
        category_id = obj.get_cp(
            "category_id"
        )

        print(
            "    ",
            obj.get_name(),
            "category_id =",
            category_id,
            "type =",
            type(category_id),
            "object_type =",
            obj.get_cp(
                "object_type"
            ),
        )

        if not isinstance(
            category_id,
            (int, np.integer),
        ):
            raise TypeError(
                f"category_id of "
                f"{obj.get_name()} is not "
                f"an integer: "
                f"{category_id!r}, "
                f"type={type(category_id)}"
            )

    bop_output_dir = os.path.join(
        args.output_dir,
        "bop_data",
    )

    print(
        f"[BOP] Writing to: "
        f"{bop_output_dir}"
    )

    bproc.writer.write_bop(
        bop_output_dir,
        target_objects=(
            target_bop_objs + [box]
        ),
        dataset=FIXED_TARGET_DATASET,
        depth_scale=0.1,
        depths=data["depth"],
        colors=data["colors"],
        color_file_format="JPEG",
        ignore_dist_thres=10,
        calc_mask_info_coco=True,
        num_worker=0,
    )

    print(
        f"[SCENE {i}] BOP writer finished."
    )

    for obj in target_bop_objs:
        obj.hide(True)
        obj.disable_rigidbody()

    for obj in selected_distractors:
        obj.hide(True)
        obj.disable_rigidbody()

    box.hide(True)
    box.disable_rigidbody()

    table.hide(True)
    table.disable_rigidbody()

    print(
        f"[SCENE {i}] Done."
    )


print("Done")